OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SAML_SP_ENTITY_ID=
SAML_ACS_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_X509_CERT=
SAML_NAME_ATTRIBUTE=displayName
SAML_EMAIL_ATTRIBUTE=mail
